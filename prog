easy_size=${#easy[@]}
medium_size=${#medium[@]}
hard_size=${#hard[@]}
get-words(){ #expects input of a number ; number of words
    local count=$1
    local diff=$2
    local size=$(eval echo '$'"$diff"'_size')
    s=''
    for i in $(eval echo {0.."$count"}); do 
        local index=$(($RANDOM%$size))
        s+="$(eval echo '${'"$diff"'[$index]}') "
    done
    s+=''
    #s+="\r"
}

play-n-words(){

    get-words $1 $2
    length=$((${#s}-1))

    local IncorrectLetter=0
    for ((i=0;i<$length;));do
        local count=$(tput cols)
        #\e[2K clear entire line
        #\e[1G hide the cursor
        printf "\e[2K\e[1G\e[1;36m${s:i:count}\e[0m" 
        #printf "${s:i:count}\r"
        IFS= read -s -n 1 char
        if [[ $i -eq 0 ]];then 
            local StartTime=$(date +"%s")
        fi
        if [[ $char == "${s:i:1}" ]];then
            i=$((i+1))
        else 
            IncorrectLetter=$(($IncorrectLetter+1))
        fi
    done
    clear
    local time=$(($(date +"%s") - $StartTime))
    local score=$((60*$1/$time))
    if [[ $score -gt highest_score ]];then
         echo -e "\e[1;33m🌟 WOW! New highest score! 🌟\e[0m"
        highest_score=$score
    fi
    echo -ne "default_difficulty=$default_difficulty\nhighest_score=$highest_score">$file_name
  
    echo -e "\e[1;34m==================================\e[0m"
    echo -e "\e[1;37m Speed:            \e[1;32m$score WPM\e[0m"
    echo -e "\e[1;37m Highest score:    \e[1;33m$highest_score WPM\e[0m"
    echo -e "\e[1;37m Total Time Taken: \e[1;36m$time s\e[0m"
    echo -e "\e[1;37m Accuracy:         \e[1;35m$((100*$length/($length+$IncorrectLetter)))%\e[0m"
    echo -e "\e[1;34m==================================\e[0m\n"
    echo
}

file_name=".data"
if [[ ! -f $file_name ]];then
    echo -ne "default_difficulty=easy\nhigest_score=0">$file_name
fi
source $file_name


clear
until false; do
     echo -ne "\e[1;35m Would you like to play? (y/n): \e[0m"
    read char
    if [[ ! $char == "n" ]];then
        echo -ne "\e[1;37mDifficulty [\e[0m\e[32measy\e[0m" 
        if [[ $default_difficulty == "easy" ]];then
            echo -ne '\e[1;32m(default)\e[0m'
        fi
        echo -ne "\e[1;33m / \e[0m\e[33mmedium\e[0m"
        if [[ $default_difficulty == "medium" ]];then
            echo -ne '\e[1;33m(default)\e[0m'
        fi
        echo -ne "\e[1;31m / \e[0m\e[31mhard\e[0m"
        if [[ $default_difficulty == "hard" ]];then
            echo -ne '\e[1;31m(default)\e[0m'
        fi
        echo -ne "\e[1;37m]: \e[0m"
        read diff
        diffs=("easy" "medium" "hard")
        for difi in ${diffs[@]};do
            if [[ "$difi" == "$diff" ]];then
                default_difficulty=$difi
            fi
        done

        play-n-words $((10+$RANDOM%20)) $default_difficulty
    else
        exit
    fi
done
